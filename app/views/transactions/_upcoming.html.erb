<%# locals: (occurrences:) %>

<% if occurrences.any? %>
  <div id="upcoming" class="flex flex-col bg-container rounded-xl shadow-border-xs px-3 py-4 lg:p-4 relative group">
    <div class="grid-cols-12 bg-container-inset rounded-xl px-5 py-3 text-xs uppercase font-medium text-secondary items-center mb-4 hidden lg:grid">
      <p class="col-span-4 pl-0.5"><%= t("recurring_transactions.table.merchant") %></p>
      <p class="col-span-2 justify-self-end"><%= t("recurring_transactions.table.amount") %></p>
      <p class="col-span-1 justify-self-center"><%= t("recurring_transactions.table.expected_day") %></p>
      <p class="col-span-2 justify-self-center"><%= t("recurring_transactions.table.next_date") %></p>
      <p class="col-span-2 justify-self-center"><%= t("recurring_transactions.table.last_occurrence") %></p>
      <p class="col-span-1 justify-self-end"><%= t("recurring_transactions.table.actions") %></p>
    </div>

    <div class="divide-y divide-primary">
      <%= render partial: "transactions/upcoming_row", collection: occurrences, as: :occurrence %>
    </div>
  </div>

  <%= render "transactions/upcoming_settings_hint" %>
<% else %>
  <div class="bg-container rounded-xl shadow-border-xs">
    <%= render "recurring_transactions/empty" %>
  </div>

  <%= render "transactions/upcoming_settings_hint" %>
<% end %>
